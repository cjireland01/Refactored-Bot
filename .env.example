# Copy this file to ".env" and fill it in. Never commit the real .env.

# --- Required ---
BOT_TOKEN=your_discord_bot_token_here
# Only needed when running: npm run deploy-commands
CLIENT_ID=your_application_id_here
# Optional: register slash commands to one server only (instant, good for testing)
# GUILD_ID=

# --- Web dashboard ---
# PORT=4000
# HOST=127.0.0.1          # only this computer can open it. Leave out to allow your network.
# Protects saving changes on the dashboard (viewing stays open). Use a long random value.
# ADMIN_TOKEN=

# --- Time ---
# Zone the BR schedule changes over in (05:00 local time on each start date).
# Handles daylight saving. For a fixed UTC-5 all year, use Etc/GMT+5.
# TIMEZONE=America/New_York
# Zone for the twice-daily stats report (18:15 and 03:15). Leave out to use the
# computer's own clock.
# CRON_TIMEZONE=America/New_York

# --- Channel IDs ---
# Leave these out on the live server to use the built-in defaults.
# On a test server, set every one to that server's channel IDs.
# CHANNEL_AUTOQUEUE=
# CHANNEL_ALTQUEUE=
# CHANNEL_INTEL=
# CHANNEL_WARNINGS=
# CHANNEL_SUGGESTIONS=
# VOICE_WAITING_ROOM=
# Set a voice channel to blank to turn it off (e.g. test server with one room):
# VOICE_WAITING_ROOM_2=
# VOICE_SILENT_ROOM=
# VOICE_MUSIC_ROOM=

# --- Scraper only (npm run scrape) ---
# TURNSTILE_TOKEN=
# PLAYER_LIMIT=
