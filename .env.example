# Copy this file to ".env" and fill it in. Never commit the real .env.

# --- Required ---
BOT_TOKEN=your_discord_bot_token_here
# Only needed when running: npm run deploy-commands
CLIENT_ID=your_application_id_here
# Optional: register slash commands to one server only (instant, good for testing)
# GUILD_ID=

# --- Web dashboard ---
# PORT=4000
# HOST=127.0.0.1          # only this computer can open it. Leave out to allow your network.
# Protects saving changes on the dashboard (viewing stays open). Use a long random value.
# ADMIN_TOKEN=

# --- Discord login for the dashboard (optional) ---
# Lets squadron members sign in with Discord. Everyone in your server can look;
# people with the editor role (or any role above it) can change things.
# ALL FIVE are needed to turn it on (CLIENT_ID is set above). Without them the
# dashboard works as before (open, or protected by ADMIN_TOKEN).
# DISCORD_CLIENT_SECRET=      Developer Portal > your app > OAuth2 > Client Secret
# WEB_GUILD_ID=               your squadron server's ID (Discord Developer Mode > right-click the server > Copy Server ID)
# SESSION_SECRET=             a long random value, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PUBLIC_URL=http://localhost:4000   the address people type to open the dashboard (https://... once it is on the internet)
# WEB_EDITOR_ROLE=Chapter Master     role (or higher) allowed to change things
# WEB_VIEWER_ROLE=                   optional: a role required just to view. Blank = anyone in the server

# --- Time ---
# Zone the BR schedule changes over in (05:00 local time on each start date).
# Handles daylight saving. For a fixed UTC-5 all year, use Etc/GMT+5.
# TIMEZONE=America/New_York
# Zone for the twice-daily stats report (18:15 and 03:15). Leave out to use the
# computer's own clock.
# CRON_TIMEZONE=America/New_York

# --- Meta vehicle sheet ---
# A Google Sheet of meta vehicles. When set, the auto queue and alt queue only
# list vehicles that are on it. The sheet must be viewable by "anyone with the
# link". Paste the address of each tab (the ?gid=... part picks the tab), separated
# by a comma. Ground and air are two tabs.
# Leave blank to show every vehicle, as before.
# META_SHEET_URL=https://docs.google.com/spreadsheets/d/1Nz22-scqa38EYAejOJ_YUUVjrmiyVaUFrpGouo0g9eg/edit?gid=1194280727,https://docs.google.com/spreadsheets/d/1Nz22-scqa38EYAejOJ_YUUVjrmiyVaUFrpGouo0g9eg/edit?gid=1913555808
# META_SHEET_REFRESH_MINUTES=10

# --- Channel IDs ---
# Leave these out on the live server to use the built-in defaults.
# On a test server, set every one to that server's channel IDs.
# CHANNEL_AUTOQUEUE=
# CHANNEL_ALTQUEUE=
# CHANNEL_INTEL=
# CHANNEL_WARNINGS=
# CHANNEL_SUGGESTIONS=
# VOICE_WAITING_ROOM=
# Set a voice channel to blank to turn it off (e.g. test server with one room):
# VOICE_WAITING_ROOM_2=
# VOICE_SILENT_ROOM=
# VOICE_MUSIC_ROOM=

# --- Scraper only (npm run scrape) ---
# TURNSTILE_TOKEN=
# PLAYER_LIMIT=
